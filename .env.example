DATABASE_URL="postgresql://vish@localhost:5432/findmypaper"
# Supabase: DATABASE_URL = transaction pooler (port 6543), DIRECT_URL = session pooler (port 5432, used by migrations)
DIRECT_URL=
AUTH_SECRET="change-me"
AUTH_TRUST_HOST=true
# Optional: Google login
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional: Supabase Storage (falls back to local disk in .storage/ when unset)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=resources
